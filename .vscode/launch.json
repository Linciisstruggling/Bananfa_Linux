
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Banánfa Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bananfa_linux",
            "args": [
                "-d", "/dev/ttyACM0",
                "-v", "3",
                "-m", "50",
                "-n", "Jatekos"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
